msgstr ""
"Project-Id-Version: luci-app-echo-config 1.5.0\n"
"Language: zh_Hans\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Echo Theme Configuration"
msgstr "Echo 主题配置"

msgid "Customize colors, layout, and appearance of the Echo LuCI theme."
msgstr "自定义 Echo LuCI 主题的颜色、布局与外观。"

msgid "Global Settings"
msgstr "全局设置"

msgid "Theme Preset"
msgstr "主题预设"

msgid "OpenWrt Dashboard"
msgstr "OpenWrt 仪表盘"

msgid "Echo Default"
msgstr "Echo 默认"

msgid "Router Model"
msgstr "路由器型号"

msgid "Displayed in sidebar, e.g. OpenWrt"
msgstr "显示在侧栏的型号，例如 OpenWrt"

msgid "Accent Highlight"
msgstr "强调色"

msgid "Secondary highlight color for sidebar model label."
msgstr "侧栏型号标签的次要强调色。"

msgid "Brand Label"
msgstr "品牌标签"

msgid "Text shown below hostname in the sidebar."
msgstr "显示在侧栏主机名下方的文字。"

msgid "Primary Color (Light)"
msgstr "主色（浅色模式）"

msgid "Main accent color for light mode. Example: #0071e3"
msgstr "浅色模式主强调色。例如：#0071e3"

msgid "Primary Color (Dark)"
msgstr "主色（深色模式）"

msgid "Main accent color for dark mode. Example: #0a84ff"
msgstr "深色模式主强调色。例如：#0a84ff"

msgid "Base Font Size"
msgstr "基础字号"

msgid "Enable Status Bar"
msgstr "启用状态栏"

msgid "Show WAN/LAN/WiFi/Clients pills at the top of every page."
msgstr "在页面顶部显示 WAN/LAN/WiFi/客户端 状态胶囊。"

msgid "Enable Dashboard Cards"
msgstr "启用仪表盘卡片"

msgid "Show CPU, memory, uptime, and traffic cards on the Status Overview page."
msgstr "在状态概览页显示 CPU、内存、运行时间与流量卡片。"

msgid "Background"
msgstr "背景"

msgid "Background Mode"
msgstr "背景模式"

msgid "Default gradient"
msgstr "默认渐变"

msgid "Custom image"
msgstr "自定义图片"

msgid "None"
msgstr "无"

msgid "Custom Background"
msgstr "自定义背景"

msgid "Place an image at /www/luci-static/echo/background/bg.jpg (or .png/.webp) on the router, then select Custom image."
msgstr "将图片放到路由器的 /www/luci-static/echo/background/bg.jpg（或 .png/.webp），然后选择「自定义图片」。"

msgid "Upload Background Image"
msgstr "上传背景图片"

msgid "Supported: JPG, PNG, WebP."
msgstr "支持：JPG、PNG、WebP。"

msgid "Echo theme settings saved. Refresh the page to apply."
msgstr "Echo 主题设置已保存，请刷新页面以生效。"

msgid "Echo Theme"
msgstr "Echo 主题"
