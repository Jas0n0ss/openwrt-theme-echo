{#
  luci-theme-echo — Main page header
  Apple clarity + OpenWrt network dashboard
-#}

{%
  import { readfile, access } from 'fs';
  import { cursor } from 'uci';
  import { getuid, getspnam } from 'luci.core';

  const echo_version = trim(readfile('/usr/share/ucode/luci/template/themes/echo/version')) ?? '?';
  const boardinfo = ubus.call('system', 'board');
  const hostname = striptags(boardinfo?.hostname ?? 'OpenWrt');
  const dark_css = readfile('/www/luci-static/echo/css/dark.css');

  let echo_primary = '#0071e3';
  let echo_dark_primary = '#0a84ff';
  let echo_gold = '#c9a962';
  let echo_brand_tag = 'Echo Router';
  let echo_bg_mode = 'gradient';
  let echo_font_size = '14';
  let echo_bg_src = null;
  let echo_preset = 'openwrt';
  let echo_router_model = 'OpenWrt';

  let cfg = cursor();
  if (access('/etc/config/echo')) {
    echo_primary = cfg.get_first('echo', 'global', 'primary') ?? echo_primary;
    echo_dark_primary = cfg.get_first('echo', 'global', 'dark_primary') ?? echo_dark_primary;
    echo_gold = cfg.get_first('echo', 'global', 'gold') ?? echo_gold;
    echo_brand_tag = cfg.get_first('echo', 'global', 'brand_tag') ?? echo_brand_tag;
    echo_bg_mode = cfg.get_first('echo', 'global', 'background_mode') ?? echo_bg_mode;
    echo_font_size = cfg.get_first('echo', 'global', 'font_size') ?? echo_font_size;
    echo_preset = cfg.get_first('echo', 'global', 'preset') ?? echo_preset;
    echo_router_model = cfg.get_first('echo', 'global', 'router_model') ?? echo_router_model;
  }

  if (echo_preset == 'be88u')
    echo_preset = 'openwrt';

  const bg_dir = '/www/luci-static/echo/background';
  const img_exts = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];
  if (echo_bg_mode == 'custom') {
    for (let ext in img_exts) {
      if (access(bg_dir + '/bg' + ext)) {
        echo_bg_src = media + '/background/bg' + ext;
        break;
      }
    }
  }

  http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="auto">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#f5f5f7" id="meta-theme-color">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <title>{{ hostname }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - LuCI</title>
  <link rel="icon" href="{{ media }}/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ media }}/img/favicon.svg">
  {# LuCI bootstrap cascade — CBI/forms/widgets base; Echo CSS overrides chrome #}
  <link rel="stylesheet" href="/luci-static/bootstrap/cascade.css" data-echo-base="bootstrap">
  <link rel="stylesheet" href="{{ media }}/css/echo.css">
  <style id="dark-styles" media="(prefers-color-scheme: dark)">
    {{ dark_css }}
  </style>
  <style id="echo-config">
    html { font-size: {{ echo_font_size }}px; }
    :root {
      --echo-primary: {{ echo_primary }};
      --echo-primary-hover: {{ echo_primary }};
      --echo-brand-gold: {{ echo_gold }};
      --primary-color-high: {{ echo_primary }};
    }
    [data-theme="dark"] {
      --echo-primary: {{ echo_dark_primary }};
      --echo-primary-hover: {{ echo_dark_primary }};
      --primary-color-high: {{ echo_dark_primary }};
    }
    {% if (echo_bg_src): %}
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background: url('{{ echo_bg_src }}') center/cover no-repeat;
      opacity: 0.35;
      pointer-events: none;
      z-index: -1;
    }
    {% elif (echo_bg_mode == 'gradient'): %}
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 50% at 15% 0%, rgba(0, 113, 227, 0.07), transparent),
        radial-gradient(ellipse 50% 40% at 85% 100%, rgba(201, 169, 98, 0.05), transparent);
      pointer-events: none;
      z-index: -1;
    }
    {% endif %}
  </style>
  <script>
  (function(){
    var d = document.getElementById('dark-styles'),
        m = document.getElementById('meta-theme-color'),
        s;
    try { s = localStorage.getItem('echo-theme'); } catch(e) {}
    if (s) {
    if (s === 'dark') { d.media = 'all'; if (m) m.content = '#000000'; }
    else if (s === 'light') { d.media = 'not all'; if (m) m.content = '#f5f5f7'; }
    else { s = 'auto'; d.media = '(prefers-color-scheme: dark)'; if (m) m.content = window.matchMedia('(prefers-color-scheme: dark)').matches ? '#000000' : '#f5f5f7'; }
    } else {
      var media = d.media;
      if (media === 'all') s = 'dark';
      else if (media === 'not all') s = 'light';
      else { s = 'auto'; if (m) m.content = window.matchMedia('(prefers-color-scheme: dark)').matches ? '#000000' : '#f5f5f7'; }
    }
    document.documentElement.dataset.theme = s;
    var darkOn = (s === 'dark') || (s === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-darkmode', darkOn ? 'true' : 'false');
  })();
  </script>
  {% if (node?.css): %}
  <link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
  {% endif %}
  {% if (css): %}
  <style title="text/css">{{ css }}</style>
  {% endif %}
</head>
<body{% if (echo_preset == 'openwrt'): %} class="theme-openwrt"{% endif %}>

<div id="echo-app">
  <div id="echo-main">
    <header id="echo-nav-bar">
      <div class="nav-bar-container">
        <div class="nav-bar-row">
          <div class="header-brand{% if (echo_preset == 'openwrt'): %} openwrt-brand{% endif %}">
          {% if (echo_preset == 'openwrt'): %}
          <div class="openwrt-brand-inner">
            <div class="openwrt-logo"><img src="{{ media }}/img/openwrt-logo.svg" alt="OpenWrt"></div>
            <div class="brand-text">
              {% if (echo_router_model != 'OpenWrt' && echo_router_model != ''): %}
              <span class="router-model">{{ echo_router_model }}</span>
              {% endif %}
              <span class="router-hostname">{{ hostname }}</span>
            </div>
          </div>
          {% else %}
          <div class="echo-brand-inner">
            <span class="hostname">{{ hostname }}</span>
            <span class="brand-tag">{{ echo_brand_tag }}</span>
          </div>
          {% endif %}
        </div>

          <div class="top-nav-shell">
            <div class="top-nav-wrap">
              <nav id="top-nav" class="echo-top-nav" aria-label="{{ _('Main navigation') }}"></nav>
              <div class="top-nav-more" id="top-nav-more" hidden>
                <button type="button" class="top-nav-more-btn" id="top-nav-more-btn" aria-expanded="false" aria-haspopup="true">
                  <span class="nav-label">{{ _('More') }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="top-nav-more-menu" id="top-nav-more-menu" hidden></div>
              </div>
            </div>
          </div>

          <div class="header-actions">
          <button type="button" class="header-btn" id="theme-toggle" aria-label="{{ _('Toggle theme') }}" title="{{ _('Theme') }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          </button>
          </div>
        </div>
      </div>
      {# Hidden hooks for scripts/plugins that expect bootstrap menu IDs #}
      <div class="echo-bootstrap-hooks" hidden aria-hidden="true">
        <ul id="modemenu" class="nav"></ul>
        <ul id="topmenu"></ul>
      </div>
    </header>

    <header id="echo-header">
      <div class="header-toolbar header-toolbar-container">
        <div class="header-titles">
          <div id="header-breadcrumb" class="header-breadcrumb"></div>
          <h2 id="header-title"></h2>
        </div>
      </div>
    </header>

    <div id="echo-content-wrap">
      <div class="content-tabs-container">
        <nav id="content-tabs" class="tabs" aria-label="{{ _('Section tabs') }}"></nav>
        <div id="tabmenu" class="tabs echo-tabmenu-hook" hidden aria-hidden="true"></div>
      </div>

{% if (!blank_page): %}
    <main id="maincontent">

      {% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
      <div class="alert-message warning">
        <strong>{{ _('No password set!') }}</strong>
        {{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}
        {% if (dispatcher.lookup("admin/system/admin")): %}
        <br><a href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Go to password configuration...') }}</a>
        {% endif %}
      </div>
      {% endif %}

      {% if (boardinfo.rootfs_type == "initramfs"): %}
      <div class="alert-message warning">
        <strong>{{ _('System running in recovery (initramfs) mode.') }}</strong>
        {{ _('No changes to settings will be stored and are lost after rebooting.') }}
        {% if (dispatcher.lookup("admin/system/flash")): %}
        <br><a href="{{ dispatcher.build_url('admin/system/flash') }}">{{ _('Go to firmware upgrade...') }}</a>
        {% endif %}
      </div>
      {% endif %}

      <noscript>
        <div class="alert-message warning">
          <strong>{{ _('JavaScript required!') }}</strong>
          {{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}
        </div>
      </noscript>
{% endif %}
