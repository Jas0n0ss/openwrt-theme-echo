{# luci-theme-echo — Main page footer #}
{%
  const echo_theme_repo = 'https://github.com/Jas0n0ss/openwrt-theme-echo/';

  let raw_dist = version.distname ?? 'OpenWrt';
  let distro_name = raw_dist;
  let distro_url = 'https://github.com/openwrt/openwrt/tree/master';

  if (/immortal/i.test(raw_dist)) {
    distro_name = 'ImmortalWrt';
    distro_url = 'https://github.com/immortalwrt/immortalwrt/tree/master';
  } else if (/lede/i.test(raw_dist)) {
    distro_name = 'LEDE';
    distro_url = 'https://github.com/coolsnowwolf/lede';
  } else if (/openwrt/i.test(raw_dist)) {
    distro_name = 'OpenWrt';
    distro_url = 'https://github.com/openwrt/openwrt/tree/master';
  }
%}
{% if (!blank_page): %}
    </main>
    </div><!-- #echo-content-wrap -->

    <footer id="echo-footer">
      <div class="footer-inner">
        <a class="footer-link" href="{{ distro_url }}" target="_blank" rel="noopener noreferrer">{{ distro_name }}</a>
        <span class="footer-sep" aria-hidden="true">|</span>
        <a class="footer-link" href="{{ echo_theme_repo }}" target="_blank" rel="noopener noreferrer">{{ _('Theme') }}</a>
      </div>
    </footer>
  </div>
</div>

<script>L.require('menu-echo')</script>
<script>L.require('ui-echo')</script>
<script>L.require('theme-echo')</script>
<script>L.require('dashboard-echo')</script>
<script>
if (history.scrollRestoration) history.scrollRestoration = 'manual';
</script>
{% endif %}
{% if (js): %}<script>{{ js }}</script>{% endif %}
</body>
</html>
