{# luci-theme-echo — Main page footer #}
{%
  import { readfile } from 'fs';

  const echo_version = trim(readfile('/usr/share/ucode/luci/template/themes/echo/version')) ?? '?';
  const echo_theme_repo = 'https://github.com/Jas0n0ss/openwrt-theme-echo';
  const echo_release_url = echo_theme_repo + '/releases/latest';

  let distro_name = version.distname ?? 'OpenWrt';
  if (/immortal/i.test(distro_name))
    distro_name = 'ImmortalWrt';
  else if (/lede/i.test(distro_name))
    distro_name = 'LEDE';

  let firmware_label = distro_name;
  if (version.distversion)
    firmware_label += ' ' + version.distversion;
  if (version.distrevision)
    firmware_label += ' (' + version.distrevision + ')';
%}
{% if (!blank_page): %}
    </main>
    </div><!-- #echo-content-wrap -->

    <footer id="echo-footer">
      <div class="footer-inner">
        <span class="footer-firmware">{{ firmware_label }}</span>
        <a class="footer-theme-link" href="{{ echo_release_url }}" target="_blank" rel="noopener noreferrer" title="{{ echo_theme_repo }}">
          Echo Theme v{{ echo_version }} · {{ _('Download IPK') }}
        </a>
      </div>
    </footer>
  </div>
</div>

<script>L.require('menu-echo')</script>
<script>L.require('ui-echo')</script>
<script>L.require('theme-echo')</script>
<script>L.require('dashboard-echo')</script>
<script>
if (history.scrollRestoration) history.scrollRestoration = 'manual';
</script>
{% endif %}
{% if (js): %}<script>{{ js }}</script>{% endif %}
</body>
</html>
