{# luci-theme-echo — Login page #}
{%
  import { readfile, access } from 'fs';
  import { cursor } from 'uci';

  const echo_version = trim(readfile('/usr/share/ucode/luci/template/themes/echo/version')) ?? '?';
  const boardinfo = ubus.call('system', 'board');
  const hostname = striptags(boardinfo?.hostname ?? 'OpenWrt');
  const dark_css = readfile('/www/luci-static/echo/css/dark.css');
  let echo_preset = 'openwrt';
  let cfg = cursor();
  if (access('/etc/config/echo')) {
    echo_preset = cfg.get_first('echo', 'global', 'preset') ?? echo_preset;
  }

  if (echo_preset == 'be88u')
    echo_preset = 'openwrt';

  http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="auto">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#000000" id="meta-theme-color">
  <title>{{ _('Login') }} - {{ hostname }}</title>
  <link rel="icon" href="{{ media }}/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ media }}/img/favicon.svg">
  <link rel="stylesheet" href="{{ media }}/css/echo.css">
  <style id="dark-styles" media="(prefers-color-scheme: dark)">{{ dark_css }}</style>
  <script>
  (function(){
    var d = document.getElementById('dark-styles'), m = document.getElementById('meta-theme-color'), s;
    try { s = localStorage.getItem('echo-theme'); } catch(e) {}
    if (!s) s = 'auto';
    document.documentElement.dataset.theme = s;
    if (s === 'dark') { d.media = 'all'; if (m) m.content = '#000000'; }
    else if (s === 'light') { d.media = 'not all'; if (m) m.content = '#f5f5f7'; }
    else { d.media = '(prefers-color-scheme: dark)'; if (m) m.content = window.matchMedia('(prefers-color-scheme: dark)').matches ? '#000000' : '#f5f5f7'; }
  })();
  </script>
</head>
<body class="echo-login{% if (echo_preset == 'openwrt'): %} theme-openwrt{% endif %}">

<div class="echo-login-card">
  {% if (fuser): %}
  <div class="echo-login-error">{{ _('Invalid username and/or password! Please try again.') }}</div>
  {% endif %}

  <div class="echo-login-form-area">
    {% if (echo_preset == 'openwrt'): %}
    <div class="openwrt-login-brand echo-login-brand-center">
      <img src="{{ media }}/img/openwrt-logo.svg" alt="OpenWrt" class="openwrt-login-logo">
    </div>
    {% else %}
    <div class="echo-login-brand-center">
      <div class="echo-login-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>
      </div>
      <h1 class="echo-login-hostname">{{ hostname }}</h1>
    </div>
    {% endif %}

    <p class="echo-login-subtitle">{{ _('Sign in to manage your router') }}</p>

    <form method="post" action="{{ dispatcher.build_url('login') }}" class="echo-login-form">
      <div class="cbi-value">
        <label class="cbi-value-title" for="luci_username">{{ _('Username') }}</label>
        <div class="cbi-value-field">
          <input class="cbi-input-text" type="text" name="luci_username" id="luci_username" value="root" autocomplete="username">
        </div>
      </div>
      <div class="cbi-value">
        <label class="cbi-value-title" for="luci_password">{{ _('Password') }}</label>
        <div class="cbi-value-field">
          <input class="cbi-input-password" type="password" name="luci_password" id="luci_password" autocomplete="current-password">
        </div>
      </div>
      <div class="cbi-page-actions">
        <button class="cbi-button cbi-button-apply" type="submit">{{ _('Log in') }}</button>
      </div>
    </form>
  </div>
</div>

<script>
var pw = document.getElementById('luci_password');
if (pw) pw.focus();
</script>
</body>
</html>
